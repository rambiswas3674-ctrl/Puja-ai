<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/puja_bg"
    android:orientation="vertical">

    <include layout="@layout/view_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/PujaSection"
                android:layout_marginTop="0dp"
                android:text="⚙️ Automation dashboard" />

            <LinearLayout
                android:id="@+id/featureList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMicPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🎤 Mic permission do" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnA11y"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="♿ Accessibility settings kholo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppInfo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 App permissions kholo" />

            <TextView
                style="@style/PujaSection"
                android:text="🔒 Privacy: kya store hai" />

            <TextView
                android:id="@+id/privacyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:textColor="@color/puja_text"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWipe"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🗑️ Saara local data delete karo" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
